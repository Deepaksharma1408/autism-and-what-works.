{% comment %}
  Judge.me Review App Integration Snippet for Autism and What Works
{% endcomment %}
{% if widget_type == 'judgeme_review_badge' %}
  <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'>
    {{ product.metafields.judgeme.badge }}
  </div>
{% elsif widget_type == 'judgeme_review_widget' %}
  <div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}'>
    {{ product.metafields.judgeme.widget }}
  </div>
{% endif %}
